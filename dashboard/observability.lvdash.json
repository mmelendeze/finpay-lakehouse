{
  "datasets": [
    {
      "name": "ds_successful_by_layer",
      "displayName": "Registros Exitosos por Capa",
      "queryLines": [
        "SELECT\r\n",
        "\r\n",
        "    origin.flow_name AS table_name,\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN origin.flow_name LIKE '%bronze%' THEN 'Bronze'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%silver%'\r\n",
        "          OR origin.flow_name LIKE '%stg_%' THEN 'Silver'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%gold%' THEN 'Gold'\r\n",
        "\r\n",
        "        ELSE 'Other'\r\n",
        "    END AS layer,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "\r\n",
        "        CASE\r\n",
        "\r\n",
        "            -- =========================================================\r\n",
        "            -- BRONZE\r\n",
        "            -- =========================================================\r\n",
        "\r\n",
        "            WHEN origin.flow_name LIKE 'fintech_finpay.bronze.users'\r\n",
        "              OR origin.flow_name LIKE 'fintech_finpay.bronze.transactions'\r\n",
        "              OR origin.flow_name LIKE 'fintech_finpay.bronze.merchants'\r\n",
        "\r\n",
        "            THEN COALESCE(\r\n",
        "                    BIGINT(details:flow_progress.metrics.num_output_rows),\r\n",
        "                    0\r\n",
        "                 )\r\n",
        "\r\n",
        "            -- =========================================================\r\n",
        "            -- SILVER\r\n",
        "            -- =========================================================\r\n",
        "\r\n",
        "            WHEN origin.flow_name LIKE 'fintech_finpay.silver.users'\r\n",
        "              OR origin.flow_name LIKE 'fintech_finpay.silver.transactions'\r\n",
        "              OR origin.flow_name LIKE 'fintech_finpay.silver.merchants'\r\n",
        "\r\n",
        "            THEN COALESCE(\r\n",
        "                    BIGINT(details:flow_progress.metrics.num_upserted_rows),\r\n",
        "                    0\r\n",
        "                 )\r\n",
        "\r\n",
        "            -- =========================================================\r\n",
        "            -- GOLD\r\n",
        "            -- =========================================================\r\n",
        "\r\n",
        "            WHEN origin.flow_name LIKE 'fintech_finpay.gold.%'\r\n",
        "\r\n",
        "            THEN COALESCE(\r\n",
        "                    BIGINT(details:flow_progress.metrics.num_output_rows),\r\n",
        "                    0\r\n",
        "                 )\r\n",
        "\r\n",
        "            ELSE 0\r\n",
        "\r\n",
        "        END\r\n",
        "\r\n",
        "    ) AS successful_records,\r\n",
        "\r\n",
        "    DATE(timestamp) AS processing_date\r\n",
        "\r\n",
        "FROM fintech_finpay.observability.event_log\r\n",
        "\r\n",
        "WHERE event_type = 'flow_progress'\r\n",
        "\r\n",
        "    AND details:flow_progress.status = 'RUNNING'\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "    origin.flow_name,\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN origin.flow_name LIKE '%bronze%' THEN 'Bronze'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%silver%'\r\n",
        "          OR origin.flow_name LIKE '%stg_%' THEN 'Silver'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%gold%' THEN 'Gold'\r\n",
        "\r\n",
        "        ELSE 'Other'\r\n",
        "    END,\r\n",
        "\r\n",
        "    DATE(timestamp)\r\n",
        "\r\n",
        "ORDER BY\r\n",
        "    processing_date DESC,\r\n",
        "    layer,\r\n",
        "    table_name;"
      ],
      "catalog": "fintech_finpay",
      "schema": "observability"
    },
    {
      "name": "ds_failed_by_expectation",
      "displayName": "Rechazados por Expectativa",
      "queryLines": [
        "SELECT\r\n",
        "\r\n",
        "    origin.flow_name AS table_name,\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN origin.flow_name LIKE '%bronze%' THEN 'Bronze'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%silver%'\r\n",
        "          OR origin.flow_name LIKE '%stg_%' THEN 'Silver'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%gold%' THEN 'Gold'\r\n",
        "\r\n",
        "        ELSE 'Other'\r\n",
        "    END AS layer,\r\n",
        "\r\n",
        "    exp.name AS expectation_name,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "        COALESCE(\r\n",
        "            BIGINT(exp.failed_records),\r\n",
        "            0\r\n",
        "        )\r\n",
        "    ) AS failed_records,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "        COALESCE(\r\n",
        "            BIGINT(exp.passed_records),\r\n",
        "            0\r\n",
        "        )\r\n",
        "    ) AS passed_records,\r\n",
        "\r\n",
        "    DATE(timestamp) AS processing_date\r\n",
        "\r\n",
        "FROM fintech_finpay.observability.event_log\r\n",
        "\r\n",
        "LATERAL VIEW OUTER EXPLODE(\r\n",
        "\r\n",
        "    from_json(\r\n",
        "        details:flow_progress.data_quality.expectations,\r\n",
        "        'array<struct<name:string,passed_records:bigint,failed_records:bigint>>'\r\n",
        "    )\r\n",
        "\r\n",
        ") AS exp\r\n",
        "\r\n",
        "WHERE event_type = 'flow_progress'\r\n",
        "\r\n",
        "    AND details:flow_progress.data_quality IS NOT NULL\r\n",
        "\r\n",
        "    AND details:flow_progress.status = 'RUNNING'\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "\r\n",
        "    origin.flow_name,\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN origin.flow_name LIKE '%bronze%' THEN 'Bronze'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%silver%'\r\n",
        "          OR origin.flow_name LIKE '%stg_%' THEN 'Silver'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%gold%' THEN 'Gold'\r\n",
        "\r\n",
        "        ELSE 'Other'\r\n",
        "    END,\r\n",
        "\r\n",
        "    exp.name,\r\n",
        "\r\n",
        "    DATE(timestamp)\r\n",
        "\r\n",
        "ORDER BY\r\n",
        "    failed_records DESC,\r\n",
        "    processing_date DESC,\r\n",
        "    layer,\r\n",
        "    table_name;"
      ],
      "catalog": "fintech_finpay",
      "schema": "observability"
    },
    {
      "name": "ds_daily_trend",
      "displayName": "Tendencia Diaria",
      "queryLines": [
        "SELECT\r\n",
        "\r\n",
        "    origin.flow_name AS table_name,\r\n",
        "\r\n",
        "    DATE(timestamp) AS processing_date,\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN origin.flow_name LIKE '%bronze%' THEN 'Bronze'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%silver%'\r\n",
        "          OR origin.flow_name LIKE '%stg_%' THEN 'Silver'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%gold%' THEN 'Gold'\r\n",
        "\r\n",
        "        ELSE 'Other'\r\n",
        "    END AS layer,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "\r\n",
        "        COALESCE(\r\n",
        "            BIGINT(details:flow_progress.metrics.num_input_rows),\r\n",
        "\r\n",
        "            BIGINT(details:flow_progress.metrics.num_output_rows),\r\n",
        "\r\n",
        "            BIGINT(details:flow_progress.metrics.num_upserted_rows),\r\n",
        "\r\n",
        "            0\r\n",
        "        )\r\n",
        "\r\n",
        "    ) AS input_rows,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "\r\n",
        "        COALESCE(\r\n",
        "            BIGINT(details:flow_progress.metrics.num_output_rows),\r\n",
        "\r\n",
        "            BIGINT(details:flow_progress.metrics.num_upserted_rows),\r\n",
        "\r\n",
        "            0\r\n",
        "        )\r\n",
        "\r\n",
        "    ) AS output_rows,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "\r\n",
        "        COALESCE(\r\n",
        "            BIGINT(details:flow_progress.data_quality.warned_records),\r\n",
        "            0\r\n",
        "        )\r\n",
        "\r\n",
        "    ) AS dropped_records\r\n",
        "\r\n",
        "FROM fintech_finpay.observability.event_log\r\n",
        "\r\n",
        "WHERE event_type = 'flow_progress'\r\n",
        "\r\n",
        "    AND details:flow_progress.status = 'RUNNING'\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "\r\n",
        "    origin.flow_name,\r\n",
        "\r\n",
        "    DATE(timestamp),\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN origin.flow_name LIKE '%bronze%' THEN 'Bronze'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%silver%'\r\n",
        "          OR origin.flow_name LIKE '%stg_%' THEN 'Silver'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%gold%' THEN 'Gold'\r\n",
        "\r\n",
        "        ELSE 'Other'\r\n",
        "    END\r\n",
        "\r\n",
        "ORDER BY\r\n",
        "    processing_date ASC,\r\n",
        "    layer,\r\n",
        "    table_name;"
      ],
      "catalog": "fintech_finpay",
      "schema": "observability"
    },
    {
      "name": "ds_error_rate_by_table",
      "displayName": "Tasa de Error por Tabla",
      "queryLines": [
        "SELECT\r\n",
        "\r\n",
        "    origin.flow_name AS table_name,\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN origin.flow_name LIKE '%bronze%' THEN 'Bronze'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%silver%'\r\n",
        "          OR origin.flow_name LIKE '%stg_%' THEN 'Silver'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%gold%' THEN 'Gold'\r\n",
        "\r\n",
        "        ELSE 'Other'\r\n",
        "    END AS layer,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "\r\n",
        "        COALESCE(\r\n",
        "            BIGINT(details:flow_progress.metrics.num_output_rows),\r\n",
        "            BIGINT(details:flow_progress.metrics.num_upserted_rows),\r\n",
        "            0\r\n",
        "        )\r\n",
        "\r\n",
        "    ) AS total_input,\r\n",
        "\r\n",
        "    SUM(\r\n",
        "\r\n",
        "        COALESCE(\r\n",
        "            BIGINT(details:flow_progress.data_quality.warned_records),\r\n",
        "            0\r\n",
        "        )\r\n",
        "\r\n",
        "    ) AS total_dropped,\r\n",
        "\r\n",
        "    ROUND(\r\n",
        "\r\n",
        "        SUM(\r\n",
        "            COALESCE(\r\n",
        "                BIGINT(details:flow_progress.data_quality.warned_records),\r\n",
        "                0\r\n",
        "            )\r\n",
        "        ) * 100.0\r\n",
        "\r\n",
        "        /\r\n",
        "\r\n",
        "        NULLIF(\r\n",
        "\r\n",
        "            SUM(\r\n",
        "\r\n",
        "                COALESCE(\r\n",
        "                    BIGINT(details:flow_progress.metrics.num_output_rows),\r\n",
        "                    BIGINT(details:flow_progress.metrics.num_upserted_rows),\r\n",
        "                    0\r\n",
        "                )\r\n",
        "\r\n",
        "            ),\r\n",
        "\r\n",
        "            0\r\n",
        "\r\n",
        "        ),\r\n",
        "\r\n",
        "        2\r\n",
        "\r\n",
        "    ) AS error_rate_pct\r\n",
        "\r\n",
        "FROM fintech_finpay.observability.event_log\r\n",
        "\r\n",
        "WHERE event_type = 'flow_progress'\r\n",
        "\r\n",
        "    AND details:flow_progress.status = 'RUNNING'\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "    origin.flow_name,\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN origin.flow_name LIKE '%bronze%' THEN 'Bronze'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%silver%'\r\n",
        "          OR origin.flow_name LIKE '%stg_%' THEN 'Silver'\r\n",
        "\r\n",
        "        WHEN origin.flow_name LIKE '%gold%' THEN 'Gold'\r\n",
        "\r\n",
        "        ELSE 'Other'\r\n",
        "    END\r\n",
        "\r\n",
        "ORDER BY\r\n",
        "    error_rate_pct DESC;"
      ],
      "catalog": "fintech_finpay",
      "schema": "observability"
    }
  ],
